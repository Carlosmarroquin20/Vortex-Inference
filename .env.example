# Local development overrides for the Vortex inference server.
# Copy to .env and adjust for your local setup.
# NEVER commit .env to version control — it may contain sensitive paths or tokens.
#
# In Kubernetes, these values are injected via the ConfigMap in k8s/base/configmap.yaml.
# The VORTEX_ prefix is defined in app/config.py via env_prefix="VORTEX_".

# Inference engine. llama_cpp loads the GGUF model below in-process;
# openai_compatible and anthropic forward requests to the API configured
# further down.
VORTEX_BACKEND=llama_cpp

# Path to the GGUF model file on the local filesystem (not inside Minikube).
# For local development outside Kubernetes, point this at the downloaded model.
VORTEX_MODEL_PATH=./models/phi-3-mini-4k-instruct-q4_k_m.gguf
VORTEX_MODEL_NAME=phi-3-mini-4k-instruct

# Context window size. Must not exceed the model's training context (4096 for Phi-3-mini).
VORTEX_N_CTX=4096

# Match to the number of physical CPU cores available to the process.
# On a developer laptop, 4 is a reasonable value that leaves headroom for the IDE.
VORTEX_N_THREADS=4
# Also export OMP_NUM_THREADS and OPENBLAS_NUM_THREADS with the same value in
# the shell (or `docker run -e`). They size the native libraries' thread
# pools at load time, so setting them in this file has no effect; see the
# comment next to them in k8s/base/configmap.yaml.

# Generate one token at startup so the first request does not pay for
# reading the memory-mapped weights. llama_cpp only.
VORTEX_WARMUP=true

# 0 = CPU-only inference. No GPU required for local development.
VORTEX_N_GPU_LAYERS=0

# 1 = serialized inference per process. Horizontal scaling is handled by KEDA.
VORTEX_MAX_CONCURRENT_REQUESTS=1

VORTEX_PORT=8080

# Bearer token required on /v1/completions. Leave empty to disable
# authentication for local development; the Kubernetes deployment always
# injects it from the vortex-inference-api-key Secret.
VORTEX_API_KEY=

# Serve /docs, /redoc and /openapi.json. Disabled by default in the cluster.
VORTEX_ENABLE_DOCS=true
VORTEX_INFERENCE_TIMEOUT_SECONDS=120.0

# --- Remote backends (VORTEX_BACKEND=openai_compatible or anthropic) ---
# VORTEX_MODEL_NAME must be set explicitly and is sent upstream as the model
# ID. VORTEX_MODEL_PATH, N_CTX, N_THREADS and N_GPU_LAYERS are ignored, and
# MAX_CONCURRENT_REQUESTS can be raised since generation happens upstream.
#
# OpenAI:     VORTEX_REMOTE_BASE_URL=https://api.openai.com/v1
# vLLM:       VORTEX_REMOTE_BASE_URL=http://localhost:8000/v1
# Ollama:     VORTEX_REMOTE_BASE_URL=http://localhost:11434/v1
# Anthropic:  leave empty for https://api.anthropic.com
VORTEX_REMOTE_BASE_URL=
# Required for anthropic, optional for openai_compatible.
VORTEX_REMOTE_API_KEY=
VORTEX_REMOTE_CONNECT_TIMEOUT_SECONDS=10

# openai_compatible only.
# chat (default) or completions; see app/config.py.
VORTEX_REMOTE_API_STYLE=chat
# max_completion_tokens for OpenAI reasoning models.
VORTEX_REMOTE_MAX_TOKENS_FIELD=max_tokens
# false for OpenAI reasoning models, which reject temperature and top_p.
VORTEX_REMOTE_FORWARD_SAMPLING=true

# anthropic only.
# low | medium | high | xhigh | max; empty keeps the model's default. Thinking
# tokens count against max_tokens, so "low" suits short completions.
VORTEX_ANTHROPIC_EFFORT=
# Re-run declined requests on Anthropic's recommended fallback model.
VORTEX_ANTHROPIC_REFUSAL_FALLBACK=true

# --- Fallback backend ---
# Takes requests the primary cannot serve: overloaded, failing upstream, or a
# prompt longer than its context. Empty disables it. It shares the settings
# above; the FALLBACK_REMOTE_* values replace the remote ones for it.
VORTEX_FALLBACK_BACKEND=
VORTEX_FALLBACK_MODEL_NAME=
VORTEX_FALLBACK_REMOTE_BASE_URL=
VORTEX_FALLBACK_REMOTE_API_KEY=
VORTEX_FALLBACK_FAILURE_THRESHOLD=3
VORTEX_FALLBACK_COOLDOWN_SECONDS=30

# --- Asynchronous jobs (POST /v1/jobs) ---
# Queued in RabbitMQ, tracked in Redis. Both URLs carry credentials.
VORTEX_JOBS_ENABLED=false
VORTEX_RABBITMQ_URL=
VORTEX_REDIS_URL=
VORTEX_JOBS_QUEUE=vortex.jobs
VORTEX_JOB_TTL_SECONDS=86400
VORTEX_JOB_MAX_ATTEMPTS=3
# First retry delay; doubles per attempt.
VORTEX_JOB_RETRY_DELAY_SECONDS=10
VORTEX_JOBS_SERVICE_TIMEOUT_SECONDS=5
# Metrics and probes of python -m app.worker.
VORTEX_WORKER_METRICS_PORT=9090
